# AC880PRO explicit pin constraints for Vivado 2018.3. DDR owned by MIG.
#
# 引脚映射依据厂商原理图与板卡资料整理，版权归原厂。
# 本文件仅用于说明本工程如何连线，不构成对原厂资料的再分发授权。
# 如需引用请以原厂发布的原理图与引脚表为准。
set_property PACKAGE_PIN Y9 [get_ports {sys_clk}]
set_property IOSTANDARD LVCMOS33 [get_ports {sys_clk}]
set_property PACKAGE_PIN P17 [get_ports {reset_n}]
set_property IOSTANDARD LVCMOS33 [get_ports {reset_n}]
set_property PACKAGE_PIN Y18 [get_ports {camera_pclk}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_pclk}]
set_property PACKAGE_PIN T21 [get_ports {camera_href}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_href}]
set_property PACKAGE_PIN U21 [get_ports {camera_vsync}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_vsync}]
set_property PACKAGE_PIN T22 [get_ports {camera_sda}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_sda}]
set_property PACKAGE_PIN U22 [get_ports {camera_scl}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_scl}]
set_property PACKAGE_PIN AA18 [get_ports {camera_xclk}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_xclk}]
set_property PACKAGE_PIN U17 [get_ports {camera_data[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_data[0]}]
set_property PACKAGE_PIN V17 [get_ports {camera_data[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_data[1]}]
set_property PACKAGE_PIN Y20 [get_ports {camera_data[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_data[2]}]
set_property PACKAGE_PIN Y21 [get_ports {camera_data[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_data[3]}]
set_property PACKAGE_PIN V18 [get_ports {camera_data[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_data[4]}]
set_property PACKAGE_PIN V19 [get_ports {camera_data[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_data[5]}]
set_property PACKAGE_PIN W20 [get_ports {camera_data[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_data[6]}]
set_property PACKAGE_PIN W21 [get_ports {camera_data[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_data[7]}]
set_property PACKAGE_PIN N22 [get_ports {led[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[0]}]
set_property PACKAGE_PIN P22 [get_ports {led[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[1]}]
set_property PACKAGE_PIN R18 [get_ports {led[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[2]}]
set_property PACKAGE_PIN T18 [get_ports {led[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[3]}]
set_property PACKAGE_PIN Y6 [get_ports {tmds_clk_p}]
set_property IOSTANDARD TMDS_33 [get_ports {tmds_clk_p}]
set_property PACKAGE_PIN Y5 [get_ports {tmds_clk_n}]
set_property IOSTANDARD TMDS_33 [get_ports {tmds_clk_n}]
set_property PACKAGE_PIN Y4 [get_ports {tmds_data_p[0]}]
set_property IOSTANDARD TMDS_33 [get_ports {tmds_data_p[0]}]
set_property PACKAGE_PIN AA4 [get_ports {tmds_data_n[0]}]
set_property IOSTANDARD TMDS_33 [get_ports {tmds_data_n[0]}]
set_property PACKAGE_PIN AB5 [get_ports {tmds_data_p[1]}]
set_property IOSTANDARD TMDS_33 [get_ports {tmds_data_p[1]}]
set_property PACKAGE_PIN AB4 [get_ports {tmds_data_n[1]}]
set_property IOSTANDARD TMDS_33 [get_ports {tmds_data_n[1]}]
set_property PACKAGE_PIN AB7 [get_ports {tmds_data_p[2]}]
set_property IOSTANDARD TMDS_33 [get_ports {tmds_data_p[2]}]
set_property PACKAGE_PIN AB6 [get_ports {tmds_data_n[2]}]
set_property IOSTANDARD TMDS_33 [get_ports {tmds_data_n[2]}]
set_property PULLUP true [get_ports {camera_sda camera_scl reset_n}]
create_clock -name sys_clk -period 20.000 [get_ports sys_clk]
# Camera connector PCLK is on a non-CC pin; board-specific exception only.
set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets camera_pclk_IBUF]
create_clock -name camera_pclk -period 20.000 [get_ports camera_pclk]
# Conservative provisional source-synchronous envelope, to confirm on hardware.
set_input_delay -clock camera_pclk -min 0.0 [get_ports {camera_data[*] camera_href camera_vsync}]
set_input_delay -clock camera_pclk -max 8.0 [get_ports {camera_data[*] camera_href camera_vsync}]
set_false_path -from [get_ports reset_n]
set_false_path -to [get_ports {camera_scl led[*]}]
set_false_path -from [get_ports camera_sda]
set_false_path -to [get_ports camera_sda]
set_max_delay -datapath_only 5.0 -from [get_cells -hier -filter {(NAME =~ ingress/q/wg_reg* || NAME =~ ingress/q/wb_reg*) && IS_SEQUENTIAL}] -to [get_cells -hier -filter {NAME =~ ingress/q/wg1_reg* && IS_SEQUENTIAL}]
set_max_delay -datapath_only 5.0 -from [get_cells -hier -filter {(NAME =~ ingress/q/rg_reg* || NAME =~ ingress/q/rb_reg*) && IS_SEQUENTIAL}] -to [get_cells -hier -filter {NAME =~ ingress/q/rg1_reg* && IS_SEQUENTIAL}]
set_max_delay -datapath_only 5.0 -from [get_cells -hier -filter {(NAME =~ display_q/wg_reg* || NAME =~ display_q/wb_reg*) && IS_SEQUENTIAL}] -to [get_cells -hier -filter {NAME =~ display_q/wg1_reg* && IS_SEQUENTIAL}]
set_max_delay -datapath_only 5.0 -from [get_cells -hier -filter {(NAME =~ display_q/rg_reg* || NAME =~ display_q/rb_reg*) && IS_SEQUENTIAL}] -to [get_cells -hier -filter {NAME =~ display_q/rg1_reg* && IS_SEQUENTIAL}]
set_false_path -to [get_cells -hier -regexp {.*(req_sync_reg\[0\]|status1_reg\[[0-9]+\])$}]
# Asynchronous assertion pins of explicitly marked reset synchronizers only.
# Reset release is synchronized in RTL; ordinary data paths remain timed.
set_false_path -to [get_pins -of_objects [get_cells -hier -filter {ASYNC_REG == TRUE}] -filter {REF_PIN_NAME == PRE || REF_PIN_NAME == CLR}]
set_property BITSTREAM.CONFIG.UNUSEDPIN Pullnone [current_design]
